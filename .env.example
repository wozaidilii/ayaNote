DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# AI provider: deepseek (default) | openai
AYANOTE_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# AYANOTE_MODEL=deepseek-chat

# Optional OpenAI fallback when AYANOTE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# AYANOTE_MODEL=gpt-4o-mini

# App URL (invite links + OAuth redirect fallback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Workspace OAuth (Calendar Meet + Drive transcripts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to ${NEXT_PUBLIC_APP_URL}/api/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Protect /api/cron/transcripts (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=

# LiveKit Classroom (L1 in-app 1v1 video) — https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text for classroom audio (Whisper preferred; Deepgram optional)
# OPENAI_API_KEY=   # already used above for AI; also powers Whisper
DEEPGRAM_API_KEY=
